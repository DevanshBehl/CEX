{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "MIGRATION_DATABASE_URL",
        "REDIS_URL",
        "LOG_LEVEL",
        "WEB_ORIGIN",
        "WEBAUTHN_*",
        "SESSION_*",
        "STEP_UP_MAX_AGE_SECONDS",
        "TOTP_ENCRYPTION_KEY",
        "ARGON2_*",
        "RATE_LIMIT_*",
        "RISK_*",
        "WITHDRAWAL_*",
        "SIGNER_*",
        "TREASURY_ADDRESS",
        "NONCE_POOL_SIZE",
        "OPERATOR_USER_IDS",
        "API_PORT",
        "API_HOST",
        "SOLANA_*",
        "DEPOSIT_SEED",
        "SUPPORTED_ASSETS",
        "INDEXER_*"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "REDIS_URL",
        "WEB_ORIGIN",
        "WEBAUTHN_*",
        "SESSION_*",
        "STEP_UP_MAX_AGE_SECONDS",
        "TOTP_ENCRYPTION_KEY",
        "LOG_LEVEL",
        "API_PORT",
        "API_HOST",
        "ARGON2_*",
        "RATE_LIMIT_*",
        "RISK_*",
        "WITHDRAWAL_*",
        "SIGNER_*",
        "TREASURY_ADDRESS",
        "NONCE_POOL_SIZE",
        "OPERATOR_USER_IDS",
        "MIGRATION_DATABASE_URL"
      ]
    },
    "generate": {
      "cache": false,
      "env": ["MIGRATION_DATABASE_URL", "DATABASE_URL"]
    }
  }
}
