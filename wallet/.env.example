# ---------------------------------------------------------------------------
# Wallet — Phase 1 configuration (prompt_phase1.md rules 65-67)
#
# Copy to .env and fill in. .env is gitignored and must never be committed
# (master-prompt rule 158). Every variable below is validated at boot by
# packages/config; a missing or malformed value stops the process immediately.
# ---------------------------------------------------------------------------

# Applies to the dev servers. Production builds set NODE_ENV=production
# themselves — see apps/web/package.json — because Next.js prerendering fails
# in confusing ways when a production build inherits `development`.
NODE_ENV=development
LOG_LEVEL=debug

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql://wallet_app:wallet_app@localhost:5433/wallet
REDIS_URL=redis://localhost:6380

# --- HTTP -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# No trailing slash. This is the ONLY origin CORS will accept (rule 149-150).
WEB_ORIGIN=http://localhost:3000

# --- WebAuthn ---------------------------------------------------------------
# RP ID must equal the WEBAUTHN_ORIGIN host or be a registrable suffix of it.
# These come from config and are never derived from a request header (rule 112).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Wallet
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_SECONDS=120

# --- Sessions ---------------------------------------------------------------
SESSION_COOKIE_NAME=wallet_session
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=86400
STEP_UP_MAX_AGE_SECONDS=300

# --- Cryptography -----------------------------------------------------------
# Exactly 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=replace-me-with-a-base64-encoded-32-byte-key=
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_ACCOUNT_PER_MINUTE=10
# Withdrawals are throttled separately from auth: the two exist for different
# reasons, and the risk engine's velocity rule is the real control here.
RATE_LIMIT_WITHDRAWAL_PER_MINUTE=30
# A coarse ceiling across every endpoint.
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# --- Migrations -------------------------------------------------------------
# The Prisma CLI connects as the schema owner; the API connects as wallet_app
# via DATABASE_URL above. Splitting these is what makes the append-only grant
# on audit_log meaningful (rules 107-109).
MIGRATION_DATABASE_URL=postgresql://wallet_owner:wallet_owner@localhost:5433/wallet

# --- Chain (Phase 2) --------------------------------------------------------
SOLANA_RPC_URL=http://127.0.0.1:8899
# The DEFAULT cluster: what a request naming none is answered for, and what the
# unsuffixed SOLANA_RPC_URL, TOKEN_MINTS and RISK_ASSET_LIMITS describe.
SOLANA_NETWORK=localnet

# --- Clusters (ADR-0021) ----------------------------------------------------
# Every cluster this process serves, comma-separated. Empty means just
# SOLANA_NETWORK, so a single-cluster deployment needs nothing here.
#
#   SOLANA_CLUSTERS=localnet,devnet
#
# Each additional cluster needs its OWN endpoint. Its mints and risk limits do
# NOT fall back to the unsuffixed variables: a mint address means a different
# token on a different cluster, and inheriting one would allowlist whatever
# happens to live at that address on devnet.
SOLANA_CLUSTERS=
SOLANA_RPC_URL_LOCALNET=
SOLANA_RPC_URL_DEVNET=
SOLANA_RPC_URL_TESTNET=
SOLANA_RPC_URL_MAINNET_BETA=
# Same format as TOKEN_MINTS / RISK_ASSET_LIMITS, per cluster.
TOKEN_MINTS_DEVNET=
TOKEN_MINTS_TESTNET=
TOKEN_MINTS_MAINNET_BETA=
RISK_ASSET_LIMITS_DEVNET=
RISK_ASSET_LIMITS_TESTNET=
RISK_ASSET_LIMITS_MAINNET_BETA=
# ADR-0006: only `finalized` may be used to credit. Anything below it can be
# rolled back on a fork, which would mean crediting money never received.
SOLANA_COMMITMENT=finalized
SOLANA_RPC_TIMEOUT_MS=20000
SOLANA_RPC_MAX_RETRIES=3

# Master seed for deposit-address derivation (ADR-0004). base64, >=32 bytes.
# Generate with: openssl rand -base64 64
# Phase 2 derives addresses only and never signs, but this value can regenerate
# every deposit key — Phase 4 moves it behind the MPC boundary (ADR-0005).
DEPOSIT_SEED=replace-me-with-openssl-rand-base64-64-output-at-least-44-chars

# ADR-0008: SOL only in Phase 2.
SUPPORTED_ASSETS=SOL

# --- Indexer (ADR-0007) -----------------------------------------------------
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_PAGE_SIZE=100
INDEXER_MAX_ADDRESSES_PER_CYCLE=200

# --- Risk policy (Phase 3, ADR-0010) ----------------------------------------
# Base units. Defaults are educational: chosen so every rule is reachable in
# testing, not to model a real institution's appetite.
RISK_PER_TRANSACTION_LIMIT=100000000000
RISK_DAILY_LIMIT=250000000000
RISK_VELOCITY_WINDOW_MINUTES=60
RISK_VELOCITY_MAX_COUNT=10
RISK_MANUAL_REVIEW_ABOVE=25000000000
# Value-based review (ADR-0024): only withdrawals worth more than this many US
# dollars wait for an operator; smaller ones that pass every hard check are
# approved automatically. Unpriced assets are always reviewed. Empty restores
# the per-asset base-unit thresholds.
RISK_MANUAL_REVIEW_ABOVE_USD=5000
RISK_PRICE_MAX_AGE_SECONDS=3600
RISK_NEW_DESTINATION_REVIEW=false
RISK_KNOWN_DESTINATION_WINDOW_DAYS=90

# --- Tokens (ADR-0016) ------------------------------------------------------
# SYMBOL:MINT:DECIMALS, comma-separated. What the platform will CREDIT.
#
#   TOKEN_MINTS=USDC:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v:6
#
TOKEN_MINTS=
# ASSET:PER_TRANSACTION:DAILY:REVIEW_ABOVE, in that asset's OWN base units.
#
# REQUIRED FOR EVERY MINT IN TOKEN_MINTS. An allowlisted mint absent from this
# list can be deposited and NOT withdrawn: the risk engine denies it with
# ASSET_LIMITS_NOT_CONFIGURED rather than falling back to the native asset's
# figures, which are denominated in 10^9 and would be a thousand times too
# generous against a 10^6 token. A token you can hold and cannot send is the
# shape that configuration gap takes in the product.
#
#   RISK_ASSET_LIMITS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v:10000000000:50000000000:5000000000
#
RISK_ASSET_LIMITS=

# --- Step-up tiering (ADR-0011) ---------------------------------------------
# A withdrawal at or above that asset's own review threshold — in ITS base
# units, so RISK_MANUAL_REVIEW_ABOVE for SOL and the fourth field of
# RISK_ASSET_LIMITS for a token — needs a fresher assertion than the 300s
# default: a shorter window of trust for a larger loss.
WITHDRAWAL_STEP_UP_MAX_AGE_SECONDS=60

# --- Retry budgets (ADR-0012) -----------------------------------------------
# Per-edge, because the failures are not alike: signing is an internal fault,
# broadcasting is a network dependency, expiry needs a fresh nonce.
WITHDRAWAL_SIGN_MAX_ATTEMPTS=3
WITHDRAWAL_BROADCAST_MAX_ATTEMPTS=5
WITHDRAWAL_EXPIRY_MAX_ATTEMPTS=3

# --- Signing ----------------------------------------------------------------
# `mock` produces signatures that verify against NOTHING. Config refuses it in
# production, and MockSigner refuses to construct there — two guards.
SIGNER_KIND=mock
SIGNER_KEY_REF=treasury-hot-1
# The address withdrawals are paid from, and the nonce authority.
TREASURY_ADDRESS=
NONCE_POOL_SIZE=5

WITHDRAWAL_WORKERS_ENABLED=true
WITHDRAWAL_WORKER_INTERVAL_MS=3000
WITHDRAWAL_WORKER_BATCH_SIZE=10

# Comma-separated user ids permitted to use the operator queue. Phase 3 has no
# role model; a real one is Phase 4 (ADR-0011).
OPERATOR_USER_IDS=

# --- MPC signing service (Phase 4a, ADR-0013/0014) --------------------------
# `mock` verifies against nothing; `real` speaks to services/mpc.
MPC_ENDPOINT=http://127.0.0.1:7070
# The caller's Ed25519 private key (PEM, base64). The service holds only the
# public half, so compromising the service cannot impersonate this caller.
MPC_CLIENT_PRIVATE_KEY=replace-me-base64-of-an-ed25519-pkcs8-pem
MPC_CALLER_NAME=wallet-api
# The approval authority's key. SEPARATE from the caller key on purpose: that
# one proves who is asking, this one proves the request was approved (ADR-0015).
MPC_APPROVAL_PRIVATE_KEY=replace-me-base64-of-an-ed25519-pkcs8-pem
MPC_TIMEOUT_MS=15000

# --- Valuation (Task 3, ADR-0022) -------------------------------------------
# Where spot USD prices come from.
#   coingecko  no credentials, covers SOL/USDC/USDT. The default.
#   pyth       needs PRICE_ENDPOINT: the public Hermes price-update endpoint
#              answers 401, so this wants a key or a self-hosted Hermes.
#   static     fixed prices from PRICE_STATIC, for development with no internet.
#   none       no valuation. Balances render; dollars do not.
PRICE_SOURCE=coingecko
PRICE_ENDPOINT=
PRICE_API_KEY=
# Minutes, not seconds: free tiers rate-limit hard, and one call prices every
# asset at once.
PRICE_POLL_INTERVAL_MS=300000
PRICE_REQUEST_TIMEOUT_MS=10000
# SYMBOL:IDENTIFIER overrides — a CoinGecko coin id or a Pyth feed id. A symbol
# with no mapping is NOT priced; it is never guessed.
PRICE_FEEDS=
# SYMBOL:PRICE, for PRICE_SOURCE=static.
PRICE_STATIC=

# --- Custody model (ADR-0020) -----------------------------------------------
# true  = segregated: each user's deposit address is their OWN 3-of-5 FROST
#         group, provisioned by the coordinator, and withdrawals are paid FROM
#         that address with the house paying the fee. Requires a signer that can
#         provision keys — the API refuses to start otherwise.
# false = omnibus: addresses are derived from DEPOSIT_SEED and withdrawals are
#         paid from TREASURY_ADDRESS.
SEGREGATED_CUSTODY=false

# --- services/mpc's own environment -----------------------------------------
# Key-encryption key. A secret manager holds this in any deployed environment;
# a .env is development only (ADR-0014).
MPC_KEK=replace-me-with-openssl-rand-base64-32
MPC_CALLER_PUBLIC_KEY=replace-me-base64-of-the-32-byte-public-key
MPC_DATABASE_PATH=./services/mpc/mpc.sqlite
MPC_BOOTSTRAP_KEY_REF=treasury-hot-1
# The public half. Without it the service signs anything well-formed and warns
# on every request — development only.
MPC_APPROVAL_PUBLIC_KEY=replace-me-base64-of-the-32-byte-public-key
MPC_BIND=127.0.0.1:7070
# TLS: set BOTH or NEITHER (master-prompt rule 160).
#
# Unset means plaintext, which the service permits ONLY on loopback and refuses
# outright on a public bind — so "we meant to put a proxy in front of it" is
# enforced rather than intended. Local development runs plaintext on loopback;
# any deployment sets these, or terminates TLS at a proxy in front of a
# loopback-bound service.
#
#   openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 \
#     -nodes -subj "/CN=localhost" -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
MPC_TLS_CERT=
MPC_TLS_KEY=

# --- Threshold roles (Phase 4b, ADR-0015/0020) ------------------------------
# `single-key` (default), `participant`, or `coordinator`.
MPC_ROLE=single-key
# coordinator: identifier@url for each of the five participants. The identifier
# is the hex FROST identifier, and it is required rather than inferred from
# position — a reordered roster would otherwise address the wrong host and the
# only symptom would be an aggregation failure.
MPC_PARTICIPANTS=
# participant: which roster entry this host is.
MPC_PARTICIPANT_IDENTIFIER=
# participant: every member's DKG transport key, this one included, as
# comma-separated identifier_hex=base64_x25519_public_key (ADR-0023). Obtain each
# participant's key with `wallet-mpc dkg-identity` (same MPC_KEK and
# MPC_DATABASE_PATH as the participant). Pinned here, never learned from the
# coordinator. Unset means the participant refuses DKG and cannot receive keys.
MPC_DKG_PEERS=
# coordinator: the key it authenticates to participants with (base64 32-byte
# Ed25519 seed). A participant's only legitimate caller is the coordinator, so
# each participant's MPC_CALLER_PUBLIC_KEY must be this key's PUBLIC half — the
# coordinator prints it at boot so it need not be derived by hand.
#
#   openssl rand -base64 32
MPC_COORDINATOR_KEY=

# ===========================================================================
# Matching engine (Phase S1, services/matching)
# ===========================================================================
# The engine owns price and priority and owns no money. It has no database
# handle and no network surface in S1 — the binary is a CLI, and making it
# reachable is S2's job.

# Where the write-ahead journal and snapshots live. Every command is appended
# and fsync'd here BEFORE it is matched (ADR-0028), so this directory is the
# source of truth for execution sequencing — Redis, from S2, is only transport.
MATCHING_DATA_DIR=./.matching

# How many sequences between snapshots. A snapshot is an optimisation over a
# correct baseline: recovery is snapshot-plus-tail, and a test asserts that
# equals a full replay.
MATCHING_SNAPSHOT_EVERY_N=10000

# The market this engine instance serves. Cluster-qualified, as every asset key
# is (ADR-0021). One engine, one market, one thread.
MATCHING_MARKET_ID=devnet:SOL-USDC

# Structural constraints (ADR-0027). These live on the MARKET and never on a
# request — a client-supplied collar is not a safety band, it is a field an
# attacker sets to the value that removes the band.
#
# tick: every limit price must be an exact multiple, in scaled price units
#       (ADR-0026: quote base units per base base-unit, times 1e9).
# lot:  every quantity must be an exact multiple, in base base-units.
# min notional: a floor on the TRUNCATED notional, in quote base units.
# collar: how far from the reference price an order may reach, in basis points.
MATCHING_TICK_SIZE=1000000
MATCHING_LOT_SIZE=1000000
MATCHING_MIN_NOTIONAL=1000000
MATCHING_COLLAR_BPS=1000

# pre_open (default) | open | post_only | halted.
# `halted` refuses placements and still accepts cancels: a halt stops price
# formation, it does not take away the exit.
MATCHING_MARKET_STATUS=pre_open

# --- Matching engine transport (Phase S2, ADR-0030/0031) --------------------
# S1's engine had no network surface. S2 gives it one, and most of what these
# variables do is keep that surface hard to reach by accident.

# Loopback by default. A non-loopback bind with no caller key is REFUSED at
# boot: an open port with no authentication is the failure S2 exists to avoid,
# and a firewall is not the control that makes it safe.
MATCHING_LISTEN=127.0.0.1:8080

# Base64 Ed25519 PUBLIC key of the one legitimate caller, the gateway. The
# engine holds no private key, so compromising it yields no ability to sign.
# Unset is permitted only on a loopback bind, for local development.
MATCHING_CALLER_PUBLIC_KEY=

# Signature timestamp tolerance, in seconds (ADR-0031). This is load-bearing
# TWICE — clock skew and the replay window — so changing it is a security
# decision, not a tuning knob. The replay cache's TTL is exactly this value:
# once a timestamp falls outside it, the clock check refuses the request
# anyway, which is what bounds the cache by rate x window rather than uptime.
MATCHING_TOLERANCE_SECONDS=300

# Ceiling on request ids held inside that window. Exhaustion REFUSES rather
# than forgetting — forgetting silently reopens the replay hole.
MATCHING_REPLAY_CACHE_CAPACITY=250000

# Where events go (ADR-0030). Unset means they go nowhere, and a 2xx then means
# only that the book changed — the service says so loudly at boot.
MATCHING_REDIS_URL=redis://127.0.0.1:6380
# Defaults to orders:events:<market id>.
MATCHING_STREAM_NAME=
# Approximate trimming. The stream is a transport buffer; the archive is the
# journal.
MATCHING_STREAM_MAX_LEN=100000

# How many publishes between fsyncs of the published watermark. An imprecise
# watermark costs duplicate delivery, which settlement tolerates by
# construction; a missing journal record costs a lost fill, which nothing
# tolerates. So it may LAG and must never LEAD.
MATCHING_WATERMARK_SYNC_EVERY=64

# Recent events kept in memory, so a consumer a few thousand sequences behind
# is served without a journal replay.
MATCHING_EVENT_RING_CAPACITY=50000

# How long a publish may take before the request is refused with 503. A publish
# that hangs holds the egress lock and stalls every command behind it — an
# unreachable Redis was measured at eight minutes of connection-manager backoff
# before this bound existed.
MATCHING_PUBLISH_TIMEOUT_MS=2000

# TLS. The transport can be terminated by a proxy, and then the signature is
# the only thing that still says who called — so these are not an alternative
# to MATCHING_CALLER_PUBLIC_KEY.
MATCHING_TLS_CERT=
MATCHING_TLS_KEY=
