# ---------------------------------------------------------------------------
# Wallet — Phase 1 configuration (prompt_phase1.md rules 65-67)
#
# Copy to .env and fill in. .env is gitignored and must never be committed
# (master-prompt rule 158). Every variable below is validated at boot by
# packages/config; a missing or malformed value stops the process immediately.
# ---------------------------------------------------------------------------

# Applies to the dev servers. Production builds set NODE_ENV=production
# themselves — see apps/web/package.json — because Next.js prerendering fails
# in confusing ways when a production build inherits `development`.
NODE_ENV=development
LOG_LEVEL=debug

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql://wallet_app:wallet_app@localhost:5433/wallet
REDIS_URL=redis://localhost:6380

# --- HTTP -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# No trailing slash. This is the ONLY origin CORS will accept (rule 149-150).
WEB_ORIGIN=http://localhost:3000

# --- WebAuthn ---------------------------------------------------------------
# RP ID must equal the WEBAUTHN_ORIGIN host or be a registrable suffix of it.
# These come from config and are never derived from a request header (rule 112).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Wallet
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_SECONDS=120

# --- Sessions ---------------------------------------------------------------
SESSION_COOKIE_NAME=wallet_session
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=86400
STEP_UP_MAX_AGE_SECONDS=300

# --- Cryptography -----------------------------------------------------------
# Exactly 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=replace-me-with-a-base64-encoded-32-byte-key=
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_ACCOUNT_PER_MINUTE=10

# --- Migrations -------------------------------------------------------------
# The Prisma CLI connects as the schema owner; the API connects as wallet_app
# via DATABASE_URL above. Splitting these is what makes the append-only grant
# on audit_log meaningful (rules 107-109).
MIGRATION_DATABASE_URL=postgresql://wallet_owner:wallet_owner@localhost:5433/wallet

# --- Chain (Phase 2) --------------------------------------------------------
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_NETWORK=localnet
# ADR-0006: only `finalized` may be used to credit. Anything below it can be
# rolled back on a fork, which would mean crediting money never received.
SOLANA_COMMITMENT=finalized
SOLANA_RPC_TIMEOUT_MS=20000
SOLANA_RPC_MAX_RETRIES=3

# Master seed for deposit-address derivation (ADR-0004). base64, >=32 bytes.
# Generate with: openssl rand -base64 64
# Phase 2 derives addresses only and never signs, but this value can regenerate
# every deposit key — Phase 4 moves it behind the MPC boundary (ADR-0005).
DEPOSIT_SEED=replace-me-with-openssl-rand-base64-64-output-at-least-44-chars

# ADR-0008: SOL only in Phase 2.
SUPPORTED_ASSETS=SOL

# --- Indexer (ADR-0007) -----------------------------------------------------
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_PAGE_SIZE=100
INDEXER_MAX_ADDRESSES_PER_CYCLE=200
