{
  "name": "@wallet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "reconcile": "tsx src/scripts/reconcile.ts",
    "provision-nonces": "tsx src/scripts/provision-nonces.ts",
    "grant-role": "tsx src/scripts/grant-role.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.2",
    "@wallet/auth": "workspace:*",
    "@wallet/blockchain": "workspace:*",
    "@wallet/config": "workspace:*",
    "@wallet/db": "workspace:*",
    "@wallet/errors": "workspace:*",
    "@wallet/ledger": "workspace:*",
    "@wallet/logger": "workspace:*",
    "@wallet/risk": "workspace:*",
    "@wallet/solana": "workspace:*",
    "@wallet/types": "workspace:*",
    "fastify": "5.12.4",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "4.0.2",
    "ioredis": "5.4.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "otpauth": "9.3.6"
  }
}
