// Phase 1 schema (prompt_phase1.md rules 96-109).
//
// Deliberately absent: wallets, addresses, balances, deposits, withdrawals,
// and any monetary column at all (rules 22, 205). Money is designed in Phase 2
// alongside the ledger that governs it; a `balance` column added here as a
// shortcut becomes an accounting bug there.
//
// Two conventions applied throughout, both chosen with Phase 2 in mind:
//
//   snake_case columns   — the ledger will be queried with hand-written SQL for
//                          reconciliation and invariant checks. Quoted
//                          "camelCase" identifiers make that miserable.
//   timestamptz          — every instant is stored with a zone. A ledger that
//                          records `timestamp without time zone` is one
//                          deployment-region change away from unexplainable
//                          ordering, and ordering is what a ledger sells.
//
// The Prisma CLI reads MIGRATION_DATABASE_URL from .env directly. This is the
// one documented exception to rule 56 — a separate process with its own
// configuration mechanism, no application TypeScript involved.
// See docs/adr/0003-database-roles.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Migrations run as wallet_owner; the API connects as wallet_app.
  url       = env("MIGRATION_DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
  closed
}

model User {
  // UUIDv7 generated in application code (rule 93). Time-ordered, so index
  // locality is good, without leaking a row count the way a serial does.
  id              String     @id @db.Uuid
  // Nullable: a passkey-only account is fully supported (rule 130).
  email           String?    @unique
  displayName     String?    @map("display_name")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(active)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credentials   Credential[]
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  wallets       Wallet[]

  @@map("users")
}

enum CredentialType {
  webauthn
  password
  totp
}

/// One table, three shapes (rule 97). The alternative — three tables — turns
/// "does this user still have any factor left?" into a three-way union, and
/// that question is asked on every credential revocation (rule 118).
model Credential {
  id     String         @id @db.Uuid
  userId String         @map("user_id") @db.Uuid
  type   CredentialType

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  // --- webauthn (rule 98) ---
  credentialId Bytes?   @unique @map("credential_id")
  publicKey    Bytes?   @map("public_key")
  /// Clone detection: a counter that fails to advance means two authenticators
  /// share one credential (rules 114-115).
  signCount    BigInt?  @map("sign_count")
  transports   String[] @default([])
  aaguid       String?
  backedUp     Boolean? @map("backed_up")
  deviceName   String?  @map("device_name")

  // --- password (rule 99) ---
  /// argon2id only. Never a reversible encoding.
  passwordHash String? @map("password_hash")

  // --- totp (rule 100) ---
  /// AES-256-GCM ciphertext. The plaintext secret exists only in the
  /// enrollment response and never again (rule 134).
  totpSecretEncrypted Bytes?    @map("totp_secret_encrypted")
  totpConfirmedAt     DateTime? @map("totp_confirmed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, revokedAt])
  @@map("credentials")
}

/// Server-side and opaque (rules 121-122). A JWT cannot be revoked before it
/// expires, and master-prompt rule 165 requires revocation.
model Session {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the token. The raw token exists only in the cookie (rule 102),
  /// so a database dump does not hand over live sessions.
  tokenHash Bytes @unique @map("token_hash")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  ip        String?
  userAgent String? @map("user_agent")

  /// Timestamp of the last successful step-up assertion (rules 135-139).
  /// null means this session has never stepped up.
  stepUpAt DateTime? @map("step_up_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use 2FA recovery codes (rule 133). Hashes only — the plaintext is
/// displayed exactly once at enrollment and is unrecoverable afterwards.
model RecoveryCode {
  id       String    @id @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash Bytes     @unique @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("recovery_codes")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// APPEND-ONLY (rules 105-108).
///
/// There is no updated_at because a row is never updated. This is enforced by
/// the database: the append_only_audit_log migration revokes UPDATE and DELETE
/// from wallet_app and installs a trigger, so the guarantee survives a bug, a
/// bad query, or a well-meaning cleanup script.
///
/// Phase 2's ledger_entries reuses this pattern verbatim. Proving it works on a
/// table where a mistake costs an audit trail rather than someone's balance is
/// the point of doing it now.
model AuditLog {
  id String @id @db.Uuid

  actorUserId String? @map("actor_user_id") @db.Uuid
  event       String
  targetType  String? @map("target_type")
  targetId    String? @map("target_id")

  /// Allowlisted fields only, mirroring @wallet/logger's allowlist (rule 105).
  metadata Json @default("{}")

  correlationId String? @map("correlation_id")
  ip            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Phase 2 — custody, ledger, and deposits
//
// Note what is still absent: any balance column, anywhere. A balance is a
// projection over ledger_entries (prompt_phase2.md rules 83-85, 196). If one
// appears here in a later phase, it is a bug, not an optimisation.
// ---------------------------------------------------------------------------

enum WalletStatus {
  active
  frozen
  closed
}

/// Custody infrastructure, not a key (master-prompt rule 92).
///
/// A wallet groups the addresses held on one chain for one user. It holds no
/// balance and no key material — it is the thing addresses hang off, so that
/// "freeze this user's custody" is one row rather than a scan.
model Wallet {
  id        String       @id @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  chain     String
  status    WalletStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  deposits  Deposit[]

  @@unique([userId, chain])
  @@index([userId])
  @@map("wallets")
}

/// Custody tiers (master-prompt rule 96).
///
/// Phase 2 writes only `deposit` and implements no behaviour for the others
/// (prompt_phase2.md rules 35, 122). They exist in the enum so Phase 4 adds
/// behaviour rather than a migration on a table that by then holds real rows.
enum CustodyRole {
  deposit
  hot
  warm
  cold
}

enum AddressStatus {
  active
  retired
}

/// PUBLIC DATA ONLY (master-prompt rules 94-95, 100).
///
/// No private key, no share, no seed. Phase 2 never signs, so no key material
/// exists to store; `derivationPath` records how the address was produced so
/// the set is reconstructible from the seed alone (ADR-0004,
/// prompt_phase2.md rules 106-107) without that seed ever living here.
model Address {
  id              String        @id @db.Uuid
  walletId        String        @map("wallet_id") @db.Uuid
  chain           String
  address         String
  derivationIndex Int           @map("derivation_index")
  derivationPath  String        @map("derivation_path")
  custodyRole     CustodyRole   @default(deposit) @map("custody_role")
  status          AddressStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wallet   Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  deposits Deposit[]
  cursor   IndexerCursor?

  @@unique([chain, address])
  @@unique([chain, derivationIndex])
  @@index([walletId, status])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

enum LedgerAccountType {
  user_available
  user_locked
  chain_assets
  house_fees
  house_rent
  external
}

/// An account is identified by (owner, asset, type) and holds NO balance.
///
/// `ownerId` is null for house and system accounts, which is why the unique key
/// includes it rather than being (asset, type).
model LedgerAccount {
  id      String            @id @db.Uuid
  ownerId String?           @map("owner_id") @db.Uuid
  asset   String
  type    LedgerAccountType

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@unique([ownerId, asset, type])
  @@index([asset, type])
  @@map("ledger_accounts")
}

enum LedgerTransactionKind {
  deposit
  withdrawal_lock
  withdrawal_release
  withdrawal_settle
  sweep
  fee
  adjustment
}

/// APPEND-ONLY. No `updatedAt`, because a transaction is never edited.
///
/// `referenceType`/`referenceId` tie it to the domain object that caused it, so
/// "why does this entry exist" is answerable from the ledger alone.
model LedgerTransaction {
  id            String                @id @db.Uuid
  kind          LedgerTransactionKind
  referenceType String                @map("reference_type")
  referenceId   String                @map("reference_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]
  deposit Deposit?

  @@index([referenceType, referenceId])
  @@index([kind, createdAt])
  @@map("ledger_transactions")
}

enum EntryDirection {
  debit
  credit
}

/// APPEND-ONLY, enforced by the database.
///
/// The grants and triggers live in the `ledger_immutability` migration and are
/// the same mechanism proven on `audit_log` in Phase 1 — which is exactly why
/// it was built there first, against a table where a mistake cost an audit
/// trail rather than someone's balance (prompt_phase2.md rules 131-133).
///
/// `amount` is NUMERIC(38,0): an integer count of base units. Never a float,
/// never a JS number (rules 59-63, 130). It is always non-negative; the sign
/// lives in `direction`.
model LedgerEntry {
  id            String         @id @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  asset         String
  amount        Decimal        @db.Decimal(38, 0)
  direction     EntryDirection

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId, asset])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Deposits
// ---------------------------------------------------------------------------

enum DepositStatus {
  /// Seen on-chain but not yet settled enough to credit (ADR-0006).
  confirming
  /// Finalized and posted to the ledger.
  credited
  /// Detected but deliberately not credited; `reason` says why.
  ignored
}

/// One detected incoming transfer.
///
/// UNIQUE(chain, tx_signature, instruction_index) IS the idempotency mechanism
/// (master-prompt rule 130, prompt_phase2.md rules 127-128). A replay is a
/// caught constraint violation and a no-op — never a read-then-write check,
/// which has a race between the read and the write that is precisely the case
/// that matters.
model Deposit {
  id        String @id @db.Uuid
  walletId  String @map("wallet_id") @db.Uuid
  addressId String @map("address_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  chain            String
  asset            String
  /// Total received on-chain, in base units.
  amount           Decimal @db.Decimal(38, 0)
  /// The portion immobilised as a rent-exempt minimum, credited to house_rent
  /// rather than to the user (rules 157-158).
  rentReserved     Decimal @default(0) @map("rent_reserved") @db.Decimal(38, 0)
  txSignature      String  @map("tx_signature")
  instructionIndex Int     @map("instruction_index")
  /// Chain position (Solana slot). BigInt: slot numbers grow without bound.
  position         BigInt

  status DepositStatus @default(confirming)
  reason String?

  ledgerTransactionId String? @unique @map("ledger_transaction_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  creditedAt  DateTime? @map("credited_at") @db.Timestamptz(3)

  wallet            Wallet             @relation(fields: [walletId], references: [id])
  address           Address            @relation(fields: [addressId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@unique([chain, txSignature, instructionIndex])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("deposits")
}

/// Where the indexer has read up to, per watched address.
///
/// Persisted ONLY after the batch it describes has committed
/// (prompt_phase2.md rules 146-147), so a restart re-processes rather than
/// skips. Re-processing is a no-op by the deposit uniqueness constraint;
/// skipping loses a deposit.
model IndexerCursor {
  id        String @id @db.Uuid
  chain     String
  addressId String @unique @map("address_id") @db.Uuid

  lastSignature String? @map("last_signature")
  lastPosition  BigInt? @map("last_position")

  lastPolledAt DateTime? @map("last_polled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  address Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@index([chain, lastPolledAt])
  @@map("indexer_cursors")
}
