// Phase 1 schema (prompt_phase1.md rules 96-109).
//
// Deliberately absent: wallets, addresses, balances, deposits, withdrawals,
// and any monetary column at all (rules 22, 205). Money is designed in Phase 2
// alongside the ledger that governs it; a `balance` column added here as a
// shortcut becomes an accounting bug there.
//
// Two conventions applied throughout, both chosen with Phase 2 in mind:
//
//   snake_case columns   — the ledger will be queried with hand-written SQL for
//                          reconciliation and invariant checks. Quoted
//                          "camelCase" identifiers make that miserable.
//   timestamptz          — every instant is stored with a zone. A ledger that
//                          records `timestamp without time zone` is one
//                          deployment-region change away from unexplainable
//                          ordering, and ordering is what a ledger sells.
//
// The Prisma CLI reads MIGRATION_DATABASE_URL from .env directly. This is the
// one documented exception to rule 56 — a separate process with its own
// configuration mechanism, no application TypeScript involved.
// See docs/adr/0003-database-roles.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Migrations run as wallet_owner; the API connects as wallet_app.
  url       = env("MIGRATION_DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
  closed
}

model User {
  // UUIDv7 generated in application code (rule 93). Time-ordered, so index
  // locality is good, without leaking a row count the way a serial does.
  id              String     @id @db.Uuid
  // Nullable: a passkey-only account is fully supported (rule 130).
  email           String?    @unique
  displayName     String?    @map("display_name")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(active)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credentials   Credential[]
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  wallets       Wallet[]
  withdrawals   Withdrawal[]
  roles         OperatorRole[]
  grantedRoles  OperatorRole[] @relation("GrantedBy")

  @@map("users")
}

/// What an operator is allowed to do (prompt_phase4.md rule 166).
///
/// Phase 3 used `OPERATOR_USER_IDS`, an environment variable. That made
/// operator authority a deploy-time property: granting it required a restart,
/// revoking it required a restart, and nothing recorded who granted it or when.
/// During an incident — which is when operator authority matters — neither
/// operation was available.
///
/// Roles are deliberately COARSE. A fine-grained permission system invites
/// inventing permissions nobody audits; these three map to the three things an
/// operator actually does, and each is a different blast radius.
enum OperatorRoleName {
  /// Read the review queue and the reconciliation report. No money moves.
  viewer
  /// Approve or reject withdrawals the risk engine referred (ADR-0010).
  approver
  /// Approve a warm-tier movement (ADR-0018), and grant or revoke roles.
  ///
  /// Separate from `approver` because approving a user's withdrawal and moving
  /// the platform's own float are different authorities, and the second should
  /// not come free with the first.
  custodian
}

/// A role grant. Append-mostly: a revocation sets `revokedAt` rather than
/// deleting the row, so "who could approve withdrawals in March" stays
/// answerable (master-prompt rule 166).
model OperatorRole {
  id     String           @id @db.Uuid
  userId String           @map("user_id") @db.Uuid
  role   OperatorRoleName

  /// Who granted it. Null only for the bootstrap grant, which the seed script
  /// makes and which is therefore the one grant with no human behind it.
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Operator-facing. Why this person has this authority.
  reason          String?

  user      User  @relation(fields: [userId], references: [id])
  grantedBy User? @relation("GrantedBy", fields: [grantedByUserId], references: [id])

  /// ONE LIVE GRANT per (user, role) is enforced by a PARTIAL unique index
  /// created in the migration:
  ///
  ///   CREATE UNIQUE INDEX ... ON (user_id, role) WHERE revoked_at IS NULL
  ///
  /// Prisma cannot express a partial index, and the `@@unique([userId, role,
  /// revokedAt])` it would generate is WRONG: PostgreSQL treats NULLs as
  /// distinct, so it permits unlimited live grants — exactly what it looks
  /// like it prevents. Declared here as a comment so nobody re-adds it.
  @@index([role, revokedAt])
  @@map("operator_roles")
}

enum CredentialType {
  webauthn
  password
  totp
}

/// One table, three shapes (rule 97). The alternative — three tables — turns
/// "does this user still have any factor left?" into a three-way union, and
/// that question is asked on every credential revocation (rule 118).
model Credential {
  id     String         @id @db.Uuid
  userId String         @map("user_id") @db.Uuid
  type   CredentialType

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  // --- webauthn (rule 98) ---
  credentialId Bytes?   @unique @map("credential_id")
  publicKey    Bytes?   @map("public_key")
  /// Clone detection: a counter that fails to advance means two authenticators
  /// share one credential (rules 114-115).
  signCount    BigInt?  @map("sign_count")
  transports   String[] @default([])
  aaguid       String?
  backedUp     Boolean? @map("backed_up")
  deviceName   String?  @map("device_name")

  // --- password (rule 99) ---
  /// argon2id only. Never a reversible encoding.
  passwordHash String? @map("password_hash")

  // --- totp (rule 100) ---
  /// AES-256-GCM ciphertext. The plaintext secret exists only in the
  /// enrollment response and never again (rule 134).
  totpSecretEncrypted Bytes?    @map("totp_secret_encrypted")
  totpConfirmedAt     DateTime? @map("totp_confirmed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, revokedAt])
  @@map("credentials")
}

/// Server-side and opaque (rules 121-122). A JWT cannot be revoked before it
/// expires, and master-prompt rule 165 requires revocation.
model Session {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the token. The raw token exists only in the cookie (rule 102),
  /// so a database dump does not hand over live sessions.
  tokenHash Bytes @unique @map("token_hash")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  ip        String?
  userAgent String? @map("user_agent")

  /// Timestamp of the last successful step-up assertion (rules 135-139).
  /// null means this session has never stepped up.
  stepUpAt DateTime? @map("step_up_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use 2FA recovery codes (rule 133). Hashes only — the plaintext is
/// displayed exactly once at enrollment and is unrecoverable afterwards.
model RecoveryCode {
  id       String    @id @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  codeHash Bytes     @unique @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("recovery_codes")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// APPEND-ONLY (rules 105-108).
///
/// There is no updated_at because a row is never updated. This is enforced by
/// the database: the append_only_audit_log migration revokes UPDATE and DELETE
/// from wallet_app and installs a trigger, so the guarantee survives a bug, a
/// bad query, or a well-meaning cleanup script.
///
/// Phase 2's ledger_entries reuses this pattern verbatim. Proving it works on a
/// table where a mistake costs an audit trail rather than someone's balance is
/// the point of doing it now.
model AuditLog {
  id String @id @db.Uuid

  actorUserId String? @map("actor_user_id") @db.Uuid
  event       String
  targetType  String? @map("target_type")
  targetId    String? @map("target_id")

  /// Allowlisted fields only, mirroring @wallet/logger's allowlist (rule 105).
  metadata Json @default("{}")

  correlationId String? @map("correlation_id")
  ip            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Phase 2 — custody, ledger, and deposits
//
// Note what is still absent: any balance column, anywhere. A balance is a
// projection over ledger_entries (prompt_phase2.md rules 83-85, 196). If one
// appears here in a later phase, it is a bug, not an optimisation.
// ---------------------------------------------------------------------------

enum WalletStatus {
  active
  frozen
  closed
}

/// Custody infrastructure, not a key (master-prompt rule 92).
///
/// A wallet groups the addresses held on one chain for one user. It holds no
/// balance and no key material — it is the thing addresses hang off, so that
/// "freeze this user's custody" is one row rather than a scan.
model Wallet {
  id        String       @id @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  chain     String
  status    WalletStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  deposits  Deposit[]

  @@unique([userId, chain])
  @@index([userId])
  @@map("wallets")
}

/// Custody tiers (master-prompt rule 96).
///
/// Phase 2 writes only `deposit` and implements no behaviour for the others
/// (prompt_phase2.md rules 35, 122). They exist in the enum so Phase 4 adds
/// behaviour rather than a migration on a table that by then holds real rows.
enum CustodyRole {
  deposit
  hot
  warm
  cold
}

enum AddressStatus {
  active
  retired
}

/// PUBLIC DATA ONLY (master-prompt rules 94-95, 100).
///
/// No private key, no share, no seed. Phase 2 never signs, so no key material
/// exists to store; `derivationPath` records how the address was produced so
/// the set is reconstructible from the seed alone (ADR-0004,
/// prompt_phase2.md rules 106-107) without that seed ever living here.
model Address {
  id              String        @id @db.Uuid
  walletId        String        @map("wallet_id") @db.Uuid
  chain           String
  address         String
  derivationIndex Int           @map("derivation_index")
  derivationPath  String        @map("derivation_path")
  custodyRole     CustodyRole   @default(deposit) @map("custody_role")
  status          AddressStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wallet   Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  deposits Deposit[]
  cursors  IndexerCursor[]

  @@unique([chain, address])
  @@unique([chain, derivationIndex])
  @@index([walletId, status])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

enum LedgerAccountType {
  user_available
  user_locked
  chain_assets
  house_fees
  house_rent
  external
}

/// An account is identified by (owner, asset, type) and holds NO balance.
///
/// `ownerId` is null for house and system accounts, which is why the unique key
/// includes it rather than being (asset, type).
model LedgerAccount {
  id      String            @id @db.Uuid
  ownerId String?           @map("owner_id") @db.Uuid
  asset   String
  type    LedgerAccountType

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@unique([ownerId, asset, type])
  @@index([asset, type])
  @@map("ledger_accounts")
}

enum LedgerTransactionKind {
  deposit
  withdrawal_lock
  withdrawal_release
  withdrawal_settle
  sweep
  fee
  adjustment
}

/// APPEND-ONLY. No `updatedAt`, because a transaction is never edited.
///
/// `referenceType`/`referenceId` tie it to the domain object that caused it, so
/// "why does this entry exist" is answerable from the ledger alone.
model LedgerTransaction {
  id            String                @id @db.Uuid
  kind          LedgerTransactionKind
  referenceType String                @map("reference_type")
  referenceId   String                @map("reference_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]
  deposit Deposit?

  @@index([referenceType, referenceId])
  @@index([kind, createdAt])
  @@map("ledger_transactions")
}

enum EntryDirection {
  debit
  credit
}

/// APPEND-ONLY, enforced by the database.
///
/// The grants and triggers live in the `ledger_immutability` migration and are
/// the same mechanism proven on `audit_log` in Phase 1 — which is exactly why
/// it was built there first, against a table where a mistake cost an audit
/// trail rather than someone's balance (prompt_phase2.md rules 131-133).
///
/// `amount` is NUMERIC(38,0): an integer count of base units. Never a float,
/// never a JS number (rules 59-63, 130). It is always non-negative; the sign
/// lives in `direction`.
model LedgerEntry {
  id            String         @id @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  asset         String
  amount        Decimal        @db.Decimal(38, 0)
  direction     EntryDirection

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId, asset])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Deposits
// ---------------------------------------------------------------------------

enum DepositStatus {
  /// Seen on-chain but not yet settled enough to credit (ADR-0006).
  confirming
  /// Finalized and posted to the ledger.
  credited
  /// Detected but deliberately not credited; `reason` says why.
  ignored
}

/// One detected incoming transfer.
///
/// UNIQUE(chain, tx_signature, instruction_index) IS the idempotency mechanism
/// (master-prompt rule 130, prompt_phase2.md rules 127-128). A replay is a
/// caught constraint violation and a no-op — never a read-then-write check,
/// which has a race between the read and the write that is precisely the case
/// that matters.
model Deposit {
  id        String @id @db.Uuid
  walletId  String @map("wallet_id") @db.Uuid
  addressId String @map("address_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  chain            String
  asset            String
  /// Total received on-chain, in base units.
  amount           Decimal @db.Decimal(38, 0)
  /// The portion immobilised as a rent-exempt minimum, credited to house_rent
  /// rather than to the user (rules 157-158).
  rentReserved     Decimal @default(0) @map("rent_reserved") @db.Decimal(38, 0)
  txSignature      String  @map("tx_signature")
  instructionIndex Int     @map("instruction_index")
  /// Chain position (Solana slot). BigInt: slot numbers grow without bound.
  position         BigInt

  status DepositStatus @default(confirming)
  reason String?

  ledgerTransactionId String? @unique @map("ledger_transaction_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  creditedAt DateTime? @map("credited_at") @db.Timestamptz(3)

  wallet            Wallet             @relation(fields: [walletId], references: [id])
  address           Address            @relation(fields: [addressId], references: [id])
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@unique([chain, txSignature, instructionIndex])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("deposits")
}

/// Where the indexer has read up to, per watched address.
///
/// Persisted ONLY after the batch it describes has committed
/// (prompt_phase2.md rules 146-147), so a restart re-processes rather than
/// skips. Re-processing is a no-op by the deposit uniqueness constraint;
/// skipping loses a deposit.
model IndexerCursor {
  id        String @id @db.Uuid
  chain     String
  addressId String @map("address_id") @db.Uuid

  /// WHICH on-chain account this cursor tracks.
  ///
  /// For a native deposit it is the deposit address itself. For a token it is
  /// that address's associated token account — because a token transfer never
  /// touches the owner's address, so the owner must be polled at a different
  /// account entirely (ADR-0016).
  ///
  /// Part of the key rather than a second table: they are the same thing,
  /// scanned in the same loop, with the same restart-safety requirement. One
  /// SHARED cursor would be the bug — advancing past a SOL transfer would skip
  /// token transfers that had not been seen, and the loss would be silent.
  scanAddress String @map("scan_address")

  lastSignature String? @map("last_signature")
  lastPosition  BigInt? @map("last_position")

  lastPolledAt DateTime? @map("last_polled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  address Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@unique([addressId, scanAddress])
  @@index([chain, lastPolledAt])
  @@map("indexer_cursors")
}

// ---------------------------------------------------------------------------
// Phase 3 — withdrawals, risk decisions, signing, and nonce accounts
// ---------------------------------------------------------------------------

/// The withdrawal state machine (prompt_phase3.md §8).
///
/// Legal transitions are declared once in packages/types and enforced twice:
/// by the type system for code that goes through the domain, and by a database
/// check constraint for everything else (rules 98-99).
enum WithdrawalStatus {
  REQUESTED
  RISK_EVALUATING
  MANUAL_REVIEW
  APPROVED
  FUNDS_LOCKED
  SIGNING
  SIGNED
  BROADCAST
  CONFIRMED
  SETTLED
  // --- failure edges, each a state rather than an exception (rule 106) ---
  SIGN_FAILED
  BROADCAST_FAILED
  EXPIRED
  REJECTED
  /// A retry budget ran out. Terminal, lock released, surfaced to an operator.
  FAILED
}

enum RiskVerdict {
  approve
  deny
  review
}

model Withdrawal {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  chain      String
  asset      String
  /// Base units. NUMERIC(38,0) — never a float, never a JS number.
  amount     Decimal  @db.Decimal(38, 0)
  /// The fee actually paid, known only after settlement.
  networkFee Decimal? @map("network_fee") @db.Decimal(38, 0)

  destination String

  status WithdrawalStatus @default(REQUESTED)

  /// UNIQUE(user_id, idempotency_key) — a resubmission is the SAME withdrawal,
  /// not a second one (master-prompt rule 87, prompt_phase3.md rules 147-148).
  idempotencyKey String @map("idempotency_key")

  /// Per-edge retry counts, persisted so a budget survives a worker restart
  /// (ADR-0012). An in-memory counter would reset and retry forever.
  signAttempts      Int @default(0) @map("sign_attempts")
  broadcastAttempts Int @default(0) @map("broadcast_attempts")
  expiryAttempts    Int @default(0) @map("expiry_attempts")

  /// Set once the lock is posted, cleared when released or settled.
  lockLedgerTransactionId   String? @map("lock_ledger_transaction_id") @db.Uuid
  settleLedgerTransactionId String? @map("settle_ledger_transaction_id") @db.Uuid

  /// The signed transaction, persisted BEFORE confirmation is awaited
  /// (master-prompt rule 141). Re-broadcast uses these exact bytes; it never
  /// re-signs (rules 140-143).
  signedTransaction Bytes?  @map("signed_transaction")
  txSignature       String? @map("tx_signature")

  /// Which nonce account this withdrawal leased, and the nonce it was built on.
  /// The nonce advancing is the proof the transaction landed (ADR-0009).
  nonceAccountId String? @map("nonce_account_id") @db.Uuid
  nonceValue     String? @map("nonce_value")

  /// Why it failed or was rejected. Operator-facing, never returned verbatim
  /// to the client.
  failureReason String? @map("failure_reason")

  correlationId String? @map("correlation_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  settledAt DateTime? @map("settled_at") @db.Timestamptz(3)

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nonceAccount    NonceAccount?          @relation(fields: [nonceAccountId], references: [id])
  transitions     WithdrawalTransition[]
  riskDecision    RiskDecision?
  signingRequests SigningRequest[]

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([txSignature])
  @@map("withdrawals")
}

/// APPEND-ONLY (prompt_phase3.md rules 100-102).
///
/// The current status is a column so it is queryable; the history is here so it
/// is complete. Both, because "where is this withdrawal" and "how did it get
/// here" are different questions and an incident needs both.
model WithdrawalTransition {
  id           String @id @db.Uuid
  withdrawalId String @map("withdrawal_id") @db.Uuid

  fromStatus WithdrawalStatus? @map("from_status")
  toStatus   WithdrawalStatus  @map("to_status")

  reason        String?
  /// null for an automated transition; set for an operator action.
  actorUserId   String? @map("actor_user_id") @db.Uuid
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId, createdAt])
  @@map("withdrawal_transitions")
}

/// Every risk evaluation, persisted with its inputs so it can be replayed
/// (master-prompt rules 152-153, prompt_phase3.md rule 205).
model RiskDecision {
  id           String @id @db.Uuid
  withdrawalId String @unique @map("withdrawal_id") @db.Uuid

  verdict        RiskVerdict
  /// The full code list. Operator-facing — the client gets a generic message.
  codes          String[]
  /// The rules that ran, so "was the daily limit checked?" is answerable from
  /// the record rather than from the code as it exists today.
  evaluatedRules String[]    @map("evaluated_rules")
  /// Inputs and per-rule detail, for replay. Amounts as strings.
  inputSnapshot  Json        @map("input_snapshot")
  outcomes       Json
  policyVersion  String      @map("policy_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([verdict, createdAt])
  @@map("risk_decisions")
}

enum SigningOutcome {
  requested
  succeeded
  failed
}

/// What was asked of the signer and what came back (master-prompt rule 110).
///
/// NEVER contains key material, a share, or the payload's secret inputs. It
/// records that a request was made, by whom, under what authorization, and the
/// outcome (prompt_phase3.md rules 129-130).
model SigningRequest {
  id           String @id @db.Uuid
  withdrawalId String @map("withdrawal_id") @db.Uuid

  /// Idempotency key handed to the signer. The same id must yield the same
  /// signature and must not start a second signing round — under threshold
  /// signing a duplicate round is a nonce-reuse hazard.
  requestId String @unique @map("request_id")
  /// Opaque handle. The application never learns what it points at.
  keyRef    String @map("key_ref")

  outcome       SigningOutcome @default(requested)
  /// Which implementation answered. `mock` must never appear in production.
  signerKind    String         @map("signer_kind")
  failureReason String?        @map("failure_reason")

  /// Who authorised, when, under which policy version. NOT the signature.
  authorization Json

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId, createdAt])
  @@map("signing_requests")
}

enum NonceAccountStatus {
  /// Created on-chain and ready to lease.
  available
  /// Leased to an in-flight withdrawal.
  leased
  /// Taken out of service.
  retired
}

/// A durable nonce account (ADR-0009).
///
/// Custody infrastructure, not an implementation detail: a transaction built on
/// a durable nonce stays valid indefinitely, which is what makes signing
/// latency safe and re-broadcast unambiguous.
///
/// One in-flight withdrawal at a time (prompt_phase3.md rule 38). Two
/// withdrawals on one nonce produce two transactions where only one can win,
/// and the loser's failure is indistinguishable from an expiry.
model NonceAccount {
  id      String @id @db.Uuid
  chain   String
  address String

  status NonceAccountStatus @default(available)

  /// The current on-chain nonce value. Advancing exactly once is the proof a
  /// transaction landed exactly once.
  currentNonce String? @map("current_nonce")

  /// Which withdrawal holds the lease, if any.
  leasedBy String?   @map("leased_by") @db.Uuid
  leasedAt DateTime? @map("leased_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  withdrawals Withdrawal[]

  @@unique([chain, address])
  @@index([chain, status])
  @@map("nonce_accounts")
}

// ---------------------------------------------------------------------------
// Valuation
// ---------------------------------------------------------------------------

/// A spot USD price, as observed at a moment (Task 3).
///
/// APPEND-ONLY, like the ledger and for the same reason: a portfolio chart is
/// an assertion about what someone's money was worth, and an assertion whose
/// inputs can be edited afterwards cannot be audited. A correction is a new
/// tick, not a rewritten one.
///
/// Keyed by `(cluster, asset)` rather than by asset alone. A devnet mint is
/// mapped to a mainnet price feed on purpose — devnet USDC has no market, and a
/// portfolio of zeroes teaches nothing — but the two are still different rows,
/// so a mainnet valuation can never read a devnet tick (ADR-0021).
///
/// `Decimal(18, 6)` rather than a float: six places is enough for every asset
/// here and the value survives the round trip exactly. A `DOUBLE PRECISION`
/// column would make `1.005` come back as `1.0049999999999999`.
model AssetPriceTick {
  id BigInt @id @default(autoincrement())

  cluster String @db.VarChar(32)

  /// The ledger asset key WITHOUT its cluster prefix: `SOL`, or a mint.
  ///
  /// The cluster is its own column here because a price row is looked up by
  /// range scan on time, and a composite text key would make that index wider
  /// for nothing. The ledger's reasoning does not apply: there is no query that
  /// could accidentally sum two clusters' prices.
  asset String @db.VarChar(128)

  priceUsd Decimal @map("price_usd") @db.Decimal(18, 6)

  /// Where the number came from, for the audit trail. Never trusted as truth.
  source String @db.VarChar(32)

  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  @@index([cluster, asset, recordedAt(sort: Desc)], name: "idx_asset_price_ticks")
  @@map("asset_price_ticks")
}
