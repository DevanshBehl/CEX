{
  "name": "@wallet/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "node scripts/check-transition-constraints.mjs && node scripts/generate-account-types.mjs --check && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:check": "node ./scripts/migrate-check.mjs",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "generate:account-types": "node scripts/generate-account-types.mjs",
    "check:account-types": "node scripts/generate-account-types.mjs --check",
    "check:transitions": "node scripts/check-transition-constraints.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "@wallet/errors": "workspace:*",
    "@wallet/types": "workspace:*",
    "uuid": "11.0.5"
  },
  "devDependencies": {
    "prisma": "6.1.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
